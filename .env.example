# Copy to .env.local and fill in Web3Forms access keys (web3forms.com).
# Each key is registered to a recipient address in their dashboard, so no email
# address is stored in this repo or shipped in the bundle.
# Project → key mapping lives in src/data/contact.ts

VITE_W3F_KEY_PRIMARY=
VITE_W3F_KEY_HOSTER=
VITE_W3F_KEY_MARYS=
VITE_W3F_KEY_ROGERS=

# Bandsintown-issued app_id for `npm run shows`
# https://help.artists.bandsintown.com/en/articles/9186477-api-documentation
BANDSINTOWN_APP_ID=

# Spotify, for `npm run listening` (scope: user-top-read)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=
SPOTIFY_PROFILE_URL=
